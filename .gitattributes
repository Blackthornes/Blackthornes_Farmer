# Windows shells are fussy about line endings: a batch file with labels and
# goto can misbehave with LF-only endings, and these files only ever run on
# Windows. Pin them so a checkout cannot normalise them to LF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# The icon is generated by tools/make_icon.py; never touch its bytes.
*.ico binary

# The frame art is generated by tools/make_frame_art.py; never touch its bytes.
*.tga binary
